# DR GESTOR PAYMENT - HOSTINGER (NODE + SUPABASE + PAYSUITE)
# Copie este ficheiro para .env no servidor Node.js da Hostinger e troque os valores abaixo.

NODE_ENV="production"
PORT="8787"
APP_URL="https://seu-dominio.com"
CORS_ORIGIN="https://seu-dominio.com"
VITE_API_PROXY_TARGET="https://seu-dominio.com"

# Login administrativo do painel
ADMIN_LOGIN="admin"
ADMIN_EMAIL="admin@seu-dominio.com"
ADMIN_PASSWORD="troque-esta-senha-forte"
ADMIN_NAME="Administrador"
AUTH_SECRET="troque-este-segredo-longo-e-unico"
AUTH_SESSION_HOURS="12"

# PaySuite
PAYSUITE_API_URL="https://paysuite.tech/api/v1"
PAYSUITE_SANDBOX_API_URL="https://paysuite.tech/api/v1"
PAYSUITE_WEBHOOK_SECRET="troque-se-a-sua-conta-usar-webhook-secret"

# Persistencia Supabase (recomendada)
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="troque-pela-service-role-key"
SUPABASE_SCHEMA="public"
SUPABASE_TABLE="dr_gestor_store"

# Persistencia MySQL (opcional, se quiser manter banco SQL tradicional)
DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_TABLE="dr_gestor_store"
DB_SSL="false"

# Campo opcional do frontend/AI
GEMINI_API_KEY=""
